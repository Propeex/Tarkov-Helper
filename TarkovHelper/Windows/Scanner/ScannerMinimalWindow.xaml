<Window x:Class="TarkovHelper.Windows.Scanner.ScannerMinimalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스캐너 미니멀 UI"
        Width="320"
        MinWidth="220"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing">
    <Border Background="#EB1A1A1A"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>
        <TextBlock x:Name="TxtItemName"
                   Text="이름 스캔 대기 중"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontFamily="{DynamicResource MaplestoryFont}"
                   FontSize="{DynamicResource FontSizeMedium}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Stretch"/>
    </Border>
</Window>
