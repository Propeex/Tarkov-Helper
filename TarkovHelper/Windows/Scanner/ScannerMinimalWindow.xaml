<Window x:Class="TarkovHelper.Windows.Scanner.ScannerMinimalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스캐너 미니멀 UI"
        Width="430"
        MinWidth="300"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing">
    <Grid Background="Transparent" Margin="4">
        <StackPanel>
            <TextBlock x:Name="TxtWaiting"
                       Text="아이템 상세 화면의 돋보기를 클릭하세요."
                       Foreground="White"
                       FontSize="18"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="1"/></TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="TxtItemName"
                       Text=""
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch"
                       Visibility="Collapsed">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="1"/></TextBlock.Effect>
            </TextBlock>

            <Border x:Name="SepPrice" Height="1" Background="#DDFFFFFF" Margin="0,10,0,9" Visibility="Collapsed"/>

            <Grid x:Name="RowAveragePrice" Margin="7,3" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="평균 일일 가격" Foreground="White" FontSize="18"/>
                <TextBlock x:Name="TxtAveragePrice" Grid.Column="1" Foreground="White" FontSize="18"/>
            </Grid>

            <Grid x:Name="RowPricePerSlot" Margin="7,3" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="칸당 가격" Foreground="White" FontSize="18"/>
                <TextBlock x:Name="TxtPricePerSlot" Grid.Column="1" Foreground="White" FontSize="18"/>
            </Grid>

            <Grid x:Name="RowTraderPrice" Margin="7,3" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTraderLabel" Text="최고 상인 판매가" Foreground="White" FontSize="18"/>
                <TextBlock x:Name="TxtTraderPrice" Grid.Column="1" Foreground="White" FontSize="18"/>
            </Grid>

            <Border x:Name="SepTracking" Height="1" Background="#DDFFFFFF" Margin="0,9,0,8" Visibility="Collapsed"/>

            <Grid x:Name="RowKappa" Margin="7,3" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="카파 퀘스트 필요" Foreground="White" FontSize="18"/>
                <TextBlock x:Name="TxtKappa" Grid.Column="1" Foreground="White" FontSize="18"/>
            </Grid>

            <StackPanel x:Name="RowNeeded" Margin="7,3" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="추가 필요 수량" Foreground="White" FontSize="18"/>
                    <TextBlock x:Name="TxtAdditionalNeeded" Grid.Column="1" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock x:Name="TxtRequirementBreakdown"
                           Margin="0,3,0,0"
                           Foreground="#E6FFFFFF"
                           FontSize="14"
                           TextAlignment="Right"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="TxtUpdatedAt"
                       Margin="7,7,0,0"
                       Foreground="#D9FFFFFF"
                       FontSize="13"
                       TextAlignment="Right"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
