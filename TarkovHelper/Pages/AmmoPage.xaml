<UserControl x:Class="TarkovHelper.Pages.AmmoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}"
             Loaded="AmmoPage_Loaded"
             Unloaded="AmmoPage_Unloaded">
    <UserControl.Resources>
        <Style x:Key="AmmoToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource MaplestoryFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AmmoGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="AmmoGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="CaliberList"
                      MinWidth="260"
                      MaxWidth="420"
                      HorizontalAlignment="Left"
                      Padding="12,8"
                      Background="{StaticResource BackgroundMediumBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      SelectionChanged="CaliberList_SelectionChanged"/>

            <ToggleButton x:Name="BtnColumnSettings"
                          Grid.Column="1"
                          Content="표시 설정"
                          Style="{StaticResource AmmoToolbarToggleStyle}"
                          Padding="14,8"
                          Margin="12,0,0,7"/>
            <Popup PlacementTarget="{Binding ElementName=BtnColumnSettings}"
                   Placement="Bottom"
                   StaysOpen="False"
                   IsOpen="{Binding IsChecked, ElementName=BtnColumnSettings, Mode=TwoWay}">
                <Border Background="{StaticResource BackgroundMediumBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <StackPanel MinWidth="230">
                        <TextBlock Text="표시할 열" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="탄 이미지와 명칭은 항상 표시됩니다." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkDamage" Content="신체 피해량" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkPenetration" Content="관통력" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkArmorDamage" Content="방탄복 피해량 %" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkAccuracy" Content="정확도 %" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkRecoil" Content="반동 %" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkFragmentation" Content="파편화 확률" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkBleed" Content="출혈 확률 L/H" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkSpeed" Content="초속" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkRicochet" Content="도탄 확률" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkMass" Content="탄두 중량" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkTracer" Content="예광탄" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkArmorClasses" Content="방탄 등급별 효율" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                        <CheckBox x:Name="ChkAcquisition" Content="입수 경로" Margin="0,3" Checked="ColumnOption_Changed" Unchecked="ColumnOption_Changed"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BackgroundLightBrush}" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="TxtSummary" Text="탄약 데이터를 불러오는 중입니다..." Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>

        <DataGrid x:Name="AmmoGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  FrozenColumnCount="2"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  Background="{StaticResource BackgroundDarkBrush}"
                  RowBackground="{StaticResource BackgroundDarkBrush}"
                  AlternatingRowBackground="{StaticResource BackgroundMediumBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  CellStyle="{StaticResource AmmoGridCellStyle}"
                  ColumnHeaderStyle="{StaticResource AmmoGridHeaderStyle}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="탄 이미지" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="58" Height="42" Margin="4">
                                <Image Source="{Binding IconPath}" Stretch="Uniform"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="명칭" Binding="{Binding NameKo}" Width="260"/>
                <DataGridTextColumn x:Name="ColDamage" Header="신체 피해량" Binding="{Binding DamageText}" Width="95"/>
                <DataGridTextColumn x:Name="ColPenetration" Header="관통력" Binding="{Binding PenetrationPower}" Width="75"/>
                <DataGridTextColumn x:Name="ColArmorDamage" Header="방탄복 피해량 %" Binding="{Binding ArmorDamageText}" Width="115"/>
                <DataGridTextColumn x:Name="ColAccuracy" Header="정확도 %" Binding="{Binding AccuracyText}" Width="80"/>
                <DataGridTextColumn x:Name="ColRecoil" Header="반동 %" Binding="{Binding RecoilText}" Width="75"/>
                <DataGridTextColumn x:Name="ColFragmentation" Header="파편화 확률" Binding="{Binding FragmentationText}" Width="100"/>
                <DataGridTextColumn x:Name="ColBleed" Header="출혈 확률 L/H" Binding="{Binding BleedText}" Width="115"/>
                <DataGridTextColumn x:Name="ColSpeed" Header="초속" Binding="{Binding InitialSpeedText}" Width="90"/>
                <DataGridTextColumn x:Name="ColRicochet" Header="도탄 확률" Binding="{Binding RicochetText}" Width="90"/>
                <DataGridTextColumn x:Name="ColMass" Header="탄두 중량" Binding="{Binding BulletMassText}" Width="85"/>
                <DataGridTextColumn x:Name="ColTracer" Header="예광탄" Binding="{Binding TracerText}" Width="120"/>
                <DataGridTemplateColumn x:Name="ColArmorClasses" Header="방탄 등급별 탄환 효율" Width="225">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding ArmorClasses}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Background}" CornerRadius="2" Margin="2" Padding="5,3" ToolTip="{Binding ArmorClass, StringFormat=방탄 등급 {0} · 효율 0~6}">
                                            <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Foreground}" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColAcquisition" Header="입수 경로" Binding="{Binding AcquisitionSource}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="탄도 수치는 tarkov.dev API 데이터이며, 방탄 등급별 값은 영문 위키의 0~6 효율 형식을 적용한 관통 지표입니다."
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
