<UserControl x:Class="TarkovHelper.Pages.Scanner.ScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}"
             Loaded="ScannerPage_Loaded"
             Unloaded="ScannerPage_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,16">
                <Button x:Name="BtnMinimalToggle"
                        Content="미니멀 UI 켜기"
                        Click="BtnMinimalToggle_Click"
                        Padding="16,9"
                        Margin="0,0,10,0"/>
                <Button x:Name="BtnClickThroughToggle"
                        Content="클릭 투과 끄기"
                        Click="BtnClickThroughToggle_Click"
                        Padding="16,9"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="스캔 및 미니멀 UI 설정"
                               FontSize="{DynamicResource FontSizeLarge}"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <CheckBox x:Name="ChkScannerEnabled"
                              Content="한국어 이름 스캔 사용"
                              Checked="ChkScannerEnabled_Changed"
                              Unchecked="ChkScannerEnabled_Changed"
                              Margin="0,0,0,16"/>

                    <TextBlock Text="표시 항목" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <CheckBox x:Name="ChkShowName" Content="아이템 이름" Margin="0,0,18,10" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                        <CheckBox x:Name="ChkShowAveragePrice" Content="플리마켓 평균가" Margin="0,0,18,10" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                        <CheckBox x:Name="ChkShowPricePerSlot" Content="칸당 플리마켓 가격" Margin="0,0,18,10" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                        <CheckBox x:Name="ChkShowTraderPrice" Content="최고 상인 판매가" Margin="0,0,18,10" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                        <CheckBox x:Name="ChkShowKappa" Content="카파 퀘스트 필요 여부" Margin="0,0,18,10" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                        <CheckBox x:Name="ChkShowNeeded" Content="퀘스트·은신처 필요 수량" Margin="0,0,18,10" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                    </UniformGrid>

                    <TextBlock Text="미니멀 UI 투명도" FontWeight="SemiBold"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderMinimalOpacity"
                                Grid.Column="0"
                                Minimum="35"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SliderMinimalOpacity_ValueChanged"/>
                        <TextBlock x:Name="TxtMinimalOpacity"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="90%"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource BackgroundLightBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtScannerStatus"
                               Text="스캐너 상태 확인 중..."
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="사용 방법" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,7" Text="1. 미니멀 UI를 켭니다."/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,7" Text="2. 타르코프의 아이템 상세 화면에서 좌측 상단 돋보기를 클릭합니다."/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,7" Text="3. 인식된 이름·가격·로컬 필요 수량이 미니멀 UI에 표시됩니다."/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Text="4. 클릭 투과를 켜면 미니멀 UI 아래의 게임을 그대로 조작할 수 있습니다."/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
